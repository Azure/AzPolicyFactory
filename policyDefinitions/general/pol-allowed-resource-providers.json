{
  "name": "pol-allowed-resource-providers",
  "properties": {
    "displayName": "Allowed Resource Providers",
    "description": "This policy enables you to specify which resource providers are allowed.",
    "metadata": {
      "category": "General",
      "version": "1.0.0",
      "preview": false,
      "deprecated": false
    },
    "mode": "All",
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "allowedResourceProviders": {
        "type": "array",
        "metadata": {
          "description": "The resource providers that are allowed to be deployed.",
          "displayName": "Allowed Resource Providers"
        }
      }
    },
    "policyRule": {
      "if": {
        "not": {
          "count": {
            "value": "[parameters('allowedResourceProviders')]",
            "name": "rp",
            "where": {
              "value": "[field('type')]",
              "like": "[concat(current('rp'), '/*')]"
            }
          },
          "greater": 0
        }
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
