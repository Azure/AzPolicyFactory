{
  "name": "polset-aks-control",
  "properties": {
    "displayName": "Azure Kubernetes Service Control Plane Policy Initiative",
    "description": "This policy initiative defines the CONTOSO security requirements for Azure Kubernetes Services Control Plane",
    "metadata": {
      "category": "Kubernetes",
      "version": "1.0.0",
      "preview": false,
      "deprecated": false
    },
    "parameters": {
      "AKSC-001_Effect": {
        "type": "string",
        "metadata": {
          "displayName": "AKSC-001 Effect: Azure Policy Add-on for Kubernetes service (AKS) should be installed and enabled on your clusters",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the non-compliant resource creation or update. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "AKSC-002_Effect": {
        "type": "string",
        "metadata": {
          "displayName": "AKSC-002 Effect: Azure Kubernetes Clusters should use Azure CNI Overlay",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the non-compliant resource creation or update. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "AKSC-003_Effect": {
        "type": "string",
        "defaultValue": "Deny",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "metadata": {
          "displayName": "AKSC-003 Effect: Azure Kubernetes Service Private Clusters should be enabled",
          "description": "'Audit' allows a non-compliant resource to be created or updated, but flags it as non-compliant. 'Deny' blocks the non-compliant resource creation or update. 'Disabled' turns off the policy."
        }
      },
      "AKSC-004_Effect": {
        "type": "string",
        "metadata": {
          "displayName": "AKSC-004 Effect: Azure Kubernetes Service clusters should have Defender profile enabled",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the non-compliant resource creation or update. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "AKSC-005_Effect": {
        "type": "string",
        "metadata": {
          "displayName": "AKSC-005 Effect: Temp disks and cache for agent node pools in Azure Kubernetes Service clusters should be encrypted at host",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the resource creation. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "AKSC-006_Effect": {
        "type": "string",
        "metadata": {
          "displayName": "AKSC-006 Effect: Azure Kubernetes Service Clusters should have local authentication methods disabled",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the resource creation. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "AKSC-007_Effect": {
        "type": "string",
        "metadata": {
          "displayName": "AKSC-007 Effect: Role-Based Access Control (RBAC) should be used on Kubernetes Services",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the resource creation. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "AKSC-008_Effect": {
        "type": "string",
        "metadata": {
          "displayName": "AKSC-008 Effect: Enable CSI",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the resource creation. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit"
      },
      "AKSC-008_enableDiskCSI": {
        "type": "String",
        "metadata": {
          "displayName": "AKSC-008: Enable CSI Disk Monitoring",
          "description": "Enable monitoring of disk CSI driver. 'false' will skip monitoring"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "AKSC-008_enableFileCSI": {
        "type": "String",
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ],
        "metadata": {
          "displayName": "AKSC-008: Enable CSI File Monitoring",
          "description": "Enable monitoring of file CSI driver. 'false' will skip monitoring"
        }
      },
      "AKSC-008_enableSnapshotCSI": {
        "type": "String",
        "defaultValue": "true",
        "allowedValues": [
          "true",
          "false"
        ],
        "metadata": {
          "displayName": "AKSC-008: Enable CSI Snapshot Monitoring",
          "description": "Enable monitoring of snapshot CSI driver. 'false' will skip monitoring"
        }
      },
      "AKSC-009_Effect": {
        "type": "String",
        "metadata": {
          "displayName": "AKSC-009 Effect: Azure Kubernetes Service Clusters should disable Command Invoke",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the resource creation. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "AKSC-010_Effect": {
        "type": "String",
        "metadata": {
          "displayName": "AKSC-010 Effect: Azure Kubernetes Service Clusters should enable Entra ID integration",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the resource creation. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "AKSC-011_Effect": {
        "type": "String",
        "metadata": {
          "displayName": "AKSC-011 Effect: Azure Kubernetes Service Clusters should use managed identities",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the resource creation. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      },
      "AKSC-012_Effect": {
        "type": "String",
        "metadata": {
          "displayName": "AKSC-012 Effect: Azure Kubernetes Service Clusters must not be created using a preview ARM API version",
          "description": "'Audit' allows a non-compliant resource to be created, but flags it as non-compliant. 'Deny' blocks the resource creation. 'Disabled' turns off the policy."
        },
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Deny"
      }
    },
