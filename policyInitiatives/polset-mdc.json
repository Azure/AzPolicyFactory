          "displayName": "Agentless VM Scanning Enabled",
          "description": "Enable or disable the Agentless VM Scanning add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isEntraPermissionsManagementEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "Permissions Management Enabled",
          "description": "Enable or disable the Permissions Management add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isApiPostureEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "API Security Posture Management Enabled",
          "description": "Enable or disable the API Security Posture Management add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isAgentlessServerlessPostureEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "Serverless Protection Enabled",
          "description": "Enable or disable the Serverless Protection add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },

      "isMdeDesignatedSubscriptionEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDE Designated Subscription Enabled",
          "description": "Enable or disable the MDE Designated Subscription add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "false"
      },
      "isFileIntegrityMonitoringEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "File Integrity Monitoring Enabled",
          "description": "Enable or disable the File Integrity Monitoring add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "false"
      },
      "fileIntegrityMonitoringDefaultWorkspaceId": {
        "type": "String",
        "metadata": {
          "displayName": "File Integrity Monitoring Default Workspace ID",
          "description": "Conditional: Default Workspace ID for the File Integrity Monitoring add-on feature. Required if File Integrity Monitoring is enabled and subPlan is P2.",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        },
        "defaultValue": ""
      },
      "fileIntegrityMonitoringRules": {
        "type": "Array",
        "metadata": {
          "displayName": "File Integrity Monitoring Rules",
          "description": "Conditional: Rules for the File Integrity Monitoring add-on feature. Required if File Integrity Monitoring is enabled and subPlan is P2. Rules are provided as an array of rule objects. Serialised by string() into the single escaped JSON string the FIM 'Rules' property stores. Each deployment fully REPLACES the rule set."
        },
        "defaultValue": [
          {
            "RuleName": "Sample Rule",
            "RuleDescription": "This is a sample File Integrity Monitoring rule.",
            "ChangeType": "CDMR",
            "IsEnabled": true,
            "MonitoredEntities": {
              "WindowsFiles": [
                {
                  "Path": "C:\\Windows\\System32\\drivers\\etc\\hosts",
                  "IncludeSubPaths": false
                }
              ],
              "LinuxFiles": [
                {
                  "Path": "/etc/passwd",
                  "IncludeSubPaths": false
                }
              ],
              "Registries": [
                {
                  "Path": "hklm\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\"
                }
              ]
            }
          }
        ]
      },
      "isContainerSensorEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "Container Sensor Enabled",
          "description": "Controls the container sensor extension"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isSecurityGatingEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "Container Security Gating Enabled",
          "description": "Controls the container Security Gating"
        },
        "allowedValues": [
          "True",
          "False"
        ],
        "defaultValue": "True"
      },
      "isContainerIntegrityContributionEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "Container Integrity Contribution (Security Findings) Enabled",
          "description": "Controls the containers integrity contribution extension"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isAIPromptEvidenceEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "AI Prompt Evidence Enabled",
          "description": "Controls the AI prompt evidence feature, which exposes the prompts passed between the user and the model for deeper analysis of AI-related alerts. The prompt snippets will include only segments of the user prompt or model response that were deemed suspicious and relevant for security classifications. While sensitive data or secrets are redacted, customer conversations may be deemed sensitive in nature. The evidence will be available through the Defender portal as part of each alert."
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isAIPromptSharingWithPurviewEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "AI Data Security Enabled",
          "description": "Controls the AI data security feature, allowing Microsoft Purview to access, process, and store prompts and responses, including metadata for security and compliance purposes such as sensitive information type (SIT) classification, reporting in Microsoft Purview Data Security Posture Management for AI, Audit, Insider Risk Management, Communication Compliance, and eDiscovery"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isAIModelScannerEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "AI Model Security Enabled",
          "description": "Controls the AI model scanner feature, gives you a clear, unified view of all your models registered in Azure Machine Learning Registries."
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isOnUploadMalwareScanningEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "Malware Scanning Enabled",
          "description": "Enable or disable the Malware Scanning add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "capGBPerMonthPerStorageAccount": {
        "type": "Integer",
        "metadata": {
          "displayName": "Cap GB Per Month Per Storage Account",
          "description": "Limit the GB scanned per month for each storage account within the subscription.\nValue must be an integer, 10GB or higher\nSet to -1 for unlimited scanning"
        },
        "defaultValue": -1
      },
      "blobScanResultsOptions": {
        "type": "String",
        "metadata": {
          "displayName": "Store scan results as blob index tags",
          "description": "Store every scan result as blob index tags. Each blob scan adds two index tags to the blob; one for the scan result and one for the scan time. Additional charges apply."
        },
        "allowedValues": [
          "None",
          "BlobIndexTags"
        ],
        "defaultValue": "None"
      },
      "automatedResponse": {
        "type": "String",
        "metadata": {
          "displayName": "Soft delete malicious storage blobs",
          "description": "When enabled, blobs detected as malicious will be soft deleted. Soft deleted blobs are recoverable. If soft delete isn't already enabled on the storage account, Defender for Storage will attempt to enable it automatically — but only during the initial activation of the automatic response feature."
        },
        "allowedValues": [
          "None",
          "BlobSoftDelete"
        ],
        "defaultValue": "None"
      }
    },
