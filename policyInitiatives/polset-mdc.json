{
  "name": "polset-mdc",
  "properties": {
    "displayName": "Microsoft Defender for Cloud Policy Initiative",
    "description": "This initiative includes policies that address the security controls for Microsoft Defender for Cloud.",
    "metadata": {
      "category": "Defender for Cloud",
      "version": "1.0.0",
      "preview": false,
      "deprecated": false
    },
    "parameters": {
      "MDC-001_effect": {
        "type": "string",
        "metadata": {
          "displayName": "MDC-001 Effect: Enable Defender CSPM plan",
          "description": "MDC-001 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "MDC-002_effect": {
        "type": "string",
        "metadata": {
          "displayName": "MDC-002 Effect: Enable Defender for Servers",
          "description": "MDC-002 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "MDC-002_subPlan": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-002: Defender for Servers plan",
          "description": "MDC-002: Select a Defender for Servers plan"
        },
        "allowedValues": [
          "P1",
          "P2"
        ],
        "defaultValue": "P2"
      },
      "MDC-003_effect": {
        "type": "string",
        "metadata": {
          "displayName": "MDC-003 Effect: Enable Defender for Containers",
          "description": "MDC-003 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "MDC-004_effect": {
        "type": "string",
        "defaultValue": "DeployIfNotExists",
        "metadata": {
          "displayName": "MDC-004 Effect: Enable Defender for Key Vault",
          "description": "MDC-004 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ]
      },
      "MDC-004_subPlan": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-004: Defender for Key Vault plan",
          "description": "MDC-004: Select a Defender for Key Vault plan"
        },
        "allowedValues": [
          "PerTransaction",
          "PerKeyVault"
        ],
        "defaultValue": "PerTransaction"
      },
      "MDC-005_effect": {
        "type": "string",
        "defaultValue": "DeployIfNotExists",
        "metadata": {
          "displayName": "MDC-005 Effect: Enable Defender for Azure Resource Manager",
          "description": "MDC-005 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ]
      },
      "MDC-005_subPlan": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-005: Defender for Azure Resource Manager plan",
          "description": "MDC-005: Select a Defender for Azure Resource Manager plan"
        },
        "allowedValues": [
          "PerTransaction",
          "PerKeyVault"
        ],
        "defaultValue": "PerTransaction"
      },
      "MDC-006_effect": {
        "type": "string",
        "defaultValue": "DeployIfNotExists",
        "metadata": {
          "displayName": "MDC-006 Effect: Enable Defender for Storage",
          "description": "MDC-006 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ]
      },
      "MDC-006_isOnUploadMalwareScanningEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-006: Malware Scanning Enabled",
          "description": "MDC-006: Enable or disable the Malware Scanning add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-006_capGBPerMonthPerStorageAccount": {
        "type": "Integer",
        "metadata": {
          "displayName": "MDC-006: Cap GB Per Month Per Storage Account",
          "description": "MDC-006: Limit the GB scanned per month for each storage account within the subscription.\nValue must be an integer, 10GB or higher\nSet to -1 for unlimited scanning"
        },
        "defaultValue": 10000
      },
      "MDC-006_blobScanResultsOptions": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-006: Store scan results as blob index tags",
          "description": "MDC-006: Store every scan result as blob index tags. Each blob scan adds two index tags to the blob; one for the scan result and one for the scan time. Additional charges apply."
        },
        "allowedValues": [
          "None",
          "BlobIndexTags"
        ],
        "defaultValue": "None"
      },
      "MDC-006_automatedResponse": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-006: Soft delete malicious blobs",
          "description": "MDC-006: When enabled, blobs detected as malicious will be soft deleted. Soft deleted blobs are recoverable. If soft delete isn't already enabled on the storage account, Defender for Storage will attempt to enable it automatically — but only during the initial activation of the automatic response feature."
        },
        "allowedValues": [
          "None",
          "BlobSoftDelete"
        ],
        "defaultValue": "None"
      },
      "MDC-007_effect": {
        "type": "string",
        "defaultValue": "DeployIfNotExists",
        "metadata": {
          "displayName": "MDC-007 Effect: Enable Defender for Azure SQL Database",
          "description": "MDC-007 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ]
      },
      "MDC-008_effect": {
        "type": "string",
        "defaultValue": "DeployIfNotExists",
        "metadata": {
          "displayName": "MDC-008 Effect: Enable Defender for SQL servers on machines",
          "description": "MDC-008 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ]
      },
      "MDC-009_effect": {
        "type": "string",
        "defaultValue": "DeployIfNotExists",
        "metadata": {
          "displayName": "MDC-009 Effect: Enable Defender for Open Source relational database",
          "description": "MDC-009 Effect: Enable or disable the execution of the policy"
