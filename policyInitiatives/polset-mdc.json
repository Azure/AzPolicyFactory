        "type": "String",
        "metadata": {
          "displayName": "Sensitive Data Discovery Enabled",
          "description": "Enable or disable the Sensitive Data Discovery add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isContainerRegistriesVulnerabilityAssessmentsEnabled":{
        "type": "String",
