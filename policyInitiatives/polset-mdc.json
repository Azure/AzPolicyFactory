{
  "name": "polset-mdc",
  "properties": {
    "displayName": "Microsoft Defender for Cloud Policy Initiative",
    "description": "This initiative includes policies that address the security controls for Microsoft Defender for Cloud.",
    "metadata": {
      "category": "Defender for Cloud",
      "version": "1.0.0",
      "preview": false,
      "deprecated": false
    },
    "parameters": {
      "location": {
        "type": "string",
        "metadata": {
          "displayName": "Location",
          "description": "Location of deployment."
        },
        "defaultValue": "australiaeast"
      },
      "MDC-001_effect": {
        "type": "string",
        "metadata": {
          "displayName": "MDC-001 Effect: Enable Defender CSPM plan",
          "description": "MDC-001 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "MDC-001_isSensitiveDataDiscoveryEnabled":{
        "type": "String",
        "metadata": {
          "displayName": "MDC-001: Sensitive Data Discovery Enabled",
          "description": "MDC-001: Enable or disable the Sensitive Data Discovery add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-001_isContainerRegistriesVulnerabilityAssessmentsEnabled":{
        "type": "String",
        "metadata": {
          "displayName": "MDC-001: Container Registries Vulnerability Assessments Enabled",
          "description": "MDC-001: Enable or disable the Container Registries Vulnerability Assessments add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-001_isAgentlessDiscoveryForKubernetesEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-001: Agentless Discovery for Kubernetes Enabled",
          "description": "MDC-001: Enable or disable the Agentless Discovery for Kubernetes add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-001_isAgentlessVmScanningEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-001: Agentless VM Scanning Enabled",
          "description": "MDC-001: Enable or disable the Agentless VM Scanning add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-001_isEntraPermissionsManagementEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-001: Permissions Management Enabled",
          "description": "MDC-001: Enable or disable the Permissions Management add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-001_isApiPostureEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-001: API Security Posture Management Enabled",
          "description": "MDC-001: Enable or disable the API Security Posture Management add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-001_isAgentlessServerlessPostureEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-001: Serverless Protection Enabled",
          "description": "MDC-001: Enable or disable the Serverless Protection add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-002_effect": {
        "type": "string",
        "metadata": {
          "displayName": "MDC-002 Effect: Enable Defender for Servers",
          "description": "MDC-002 Effect: Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ],
        "defaultValue": "DeployIfNotExists"
      },
      "MDC-002_subPlan": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-002: Defender for Servers plans",
          "description": "MDC-002: Select a Defender for Servers plan"
        },
        "allowedValues": [
          "P1",
          "P2"
        ],
        "defaultValue": "P2"
      },
       "MDC-002_isAgentlessVmScanningEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-002: Agentless VM Scanning Enabled",
          "description": "MDC-002: Enable or disable the Agentless VM Scanning add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "MDC-002_isMdeDesignatedSubscriptionEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-002: MDE Designated Subscription Enabled",
          "description": "MDC-002: Enable or disable the MDE Designated Subscription add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "false"
      },
      "MDC-002_isFileIntegrityMonitoringEnabled": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-002: File Integrity Monitoring Enabled",
          "description": "MDC-002: Enable or disable the File Integrity Monitoring add-on feature"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "false"
      },
      "MDC-002_fileIntegrityMonitoringDefaultWorkspaceId": {
        "type": "String",
        "metadata": {
          "displayName": "MDC-002: File Integrity Monitoring Default Workspace ID",
          "description": "MDC-002: Conditional: Default Workspace ID for the File Integrity Monitoring add-on feature. Required if File Integrity Monitoring is enabled and subPlan is P2.",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        },
        "defaultValue": ""
      },
      "MDC-002_fileIntegrityMonitoringRules": {
        "type": "Array",
        "metadata": {
          "displayName": "MDC-002: File Integrity Monitoring Rules",
          "description": "MDC-002: Conditional: Rules for the File Integrity Monitoring add-on feature. Required if File Integrity Monitoring is enabled and subPlan is P2. Rules are provided as an array of rule objects. Serialised by string() into the single escaped JSON string the FIM 'Rules' property stores. Each deployment fully REPLACES the rule set."
        },
        "defaultValue": [
          {
            "RuleName": "Sample Rule",
            "RuleDescription": "This is a sample File Integrity Monitoring rule.",
            "ChangeType": "CDMR",
            "IsEnabled": true,
            "MonitoredEntities": {
              "WindowsFiles": [
                {
                  "Path": "C:\\Windows\\System32\\drivers\\etc\\hosts",
                  "IncludeSubPaths": false
                }
              ],
              "LinuxFiles": [
                {
                  "Path": "/etc/passwd",
                  "IncludeSubPaths": false
                }
              ],
              "Registries": [
                {
                  "Path": "hklm\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\\"
                }
              ]
            }
          }
        ]
      }
    },
    "policyDefinitionGroups": [
      {
        "name": "ISO27001-2013_A.12.2.1",
