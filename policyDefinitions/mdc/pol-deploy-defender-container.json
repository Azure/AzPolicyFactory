{
  "name": "pol-deploy-defender-container",
  "properties": {
    "displayName": "Configure Microsoft Defender for Container plan",
    "mode": "All",
    "description": "Configure Microsoft Defender for Container plan with required add-on features. Set the pricing tier to Free to disable the plan.",
    "metadata": {
      "version": "1.1.0",
      "category": "Defender for Cloud",
      "preview": false,
      "deprecated": false
    },
    "parameters": {
      "effect": {
        "type": "string",
        "defaultValue": "DeployIfNotExists",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ]
      },
      "evaluationDelay": {
        "type": "string",
        "metadata": {
          "displayName": "Evaluation Delay",
          "description": "Specifies when the existence of the related resources should be evaluated. The delay is only used for evaluations that are a result of a create or update resource request. Allowed values are AfterProvisioning, AfterProvisioningSuccess, AfterProvisioningFailure, or an ISO 8601 duration between 0 and 360 minutes."
        },
        "defaultValue": "AfterProvisioning"
      },
      "pricingTier": {
        "type": "string",
        "metadata": {
          "displayName": "Pricing Tier",
          "description": "Pricing tier of the Defender for Container plan. Standard enables the plan, Free disables it. Add-on feature parameters are ignored when set to Free."
        },
        "allowedValues": [
          "Standard",
          "Free"
        ],
        "defaultValue": "Standard"
      },
      "isContainerRegistriesVulnerabilityAssessmentsEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "Container Registries Vulnerability Assessments Enabled",
          "description": "Controls the container registries vulnerability assessments extension"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isAgentlessDiscoveryForKubernetesEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "Agentless Discovery For Kubernetes Enabled",
          "description": "Controls the agentless discovery for Kubernetes extension"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isAgentlessVmScanningEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "Agentless VM Scanning Enabled",
          "description": "Controls the agentless VM scanning extension"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isContainerSensorEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "Container Sensor Enabled",
          "description": "Controls the container sensor extension"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isSecurityGatingEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "Container Security Gating Enabled",
          "description": "Controls the container Security Gating"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      },
      "isContainerIntegrityContributionEnabled": {
        "type": "string",
        "metadata": {
          "displayName": "Container Integrity Contribution (Security Findings) Enabled",
          "description": "Controls the containers integrity contribution extension"
        },
        "allowedValues": [
          "true",
          "false"
        ],
        "defaultValue": "true"
      }
    },
    "policyRule": {
      "if": {
        "field": "type",
        "equals": "Microsoft.Resources/subscriptions"
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Security/pricings",
          "evaluationDelay": "[parameters('evaluationDelay')]",
          "name": "Containers",
          "deploymentScope": "subscription",
          "existenceScope": "subscription",
          "roleDefinitionIds": [
            "/providers/Microsoft.Authorization/roleDefinitions/8e3af657-a8ff-443c-a75c-2fe8c4bcb635"
          ],
          "existenceCondition": {
            "anyOf": [
              {
                "allOf": [
                  {
                    "value": "[parameters('pricingTier')]",
                    "equals": "Free"
                  },
                  {
                    "field": "Microsoft.Security/pricings/pricingTier",
                    "equals": "Free"
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "value": "[parameters('pricingTier')]",
                    "equals": "Standard"
                  },
                  {
                    "field": "Microsoft.Security/pricings/pricingTier",
                    "equals": "Standard"
                  },
                  {
                    "count": {
                      "field": "Microsoft.Security/pricings/extensions[*]",
                      "where": {
                        "anyOf": [
                          {
                            "allOf": [
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].name",
                                "equals": "ContainerRegistriesVulnerabilityAssessments"
                              },
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].isEnabled",
                                "equals": "[parameters('isContainerRegistriesVulnerabilityAssessmentsEnabled')]"
                              }
                            ]
                          },
                          {
                            "allOf": [
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].name",
                                "equals": "AgentlessDiscoveryForKubernetes"
                              },
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].isEnabled",
                                "equals": "[parameters('isAgentlessDiscoveryForKubernetesEnabled')]"
                              }
                            ]
                          },
                          {
                            "allOf": [
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].name",
                                "equals": "AgentlessVmScanning"
                              },
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].isEnabled",
                                "equals": "[parameters('isAgentlessVmScanningEnabled')]"
                              }
                            ]
                          },
                          {
                            "allOf": [
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].name",
                                "equals": "ContainerSensor"
                              },
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].isEnabled",
                                "equals": "[parameters('isContainerSensorEnabled')]"
                              },
                              {
                                "value": "[coalesce(tryGet(current('Microsoft.Security/pricings/extensions[*].additionalExtensionProperties'), 'SecurityGatingEnabled'), '')]",
                                "equals": "[parameters('isSecurityGatingEnabled')]"
                              }
                            ]
                          },
                          {
                            "allOf": [
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].name",
                                "equals": "ContainerIntegrityContribution"
                              },
                              {
                                "field": "Microsoft.Security/pricings/extensions[*].isEnabled",
                                "equals": "[parameters('isContainerIntegrityContributionEnabled')]"
                              }
                            ]
                          }
                        ]
                      }
                    },
                    "equals": 5
                  }
                ]
              }
            ]
          },
          "deployment": {
            "location": "australiaeast",
            "properties": {
              "mode": "incremental",
              "parameters": {
                "pricingTier": {
                  "value": "[parameters('pricingTier')]"
                },
                "isContainerRegistriesVulnerabilityAssessmentsEnabled": {
                  "value": "[parameters('isContainerRegistriesVulnerabilityAssessmentsEnabled')]"
                },
                "isAgentlessDiscoveryForKubernetesEnabled": {
                  "value": "[parameters('isAgentlessDiscoveryForKubernetesEnabled')]"
                },
                "isAgentlessVmScanningEnabled": {
                  "value": "[parameters('isAgentlessVmScanningEnabled')]"
                },
                "isContainerSensorEnabled": {
                  "value": "[parameters('isContainerSensorEnabled')]"
                },
                "isSecurityGatingEnabled": {
                  "value": "[parameters('isSecurityGatingEnabled')]"
                },
                "isContainerIntegrityContributionEnabled": {
                  "value": "[parameters('isContainerIntegrityContributionEnabled')]"
                }
              },
              "template": {
                "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
                "contentVersion": "1.0.0.0",
                "parameters": {
                  "pricingTier": {
                    "type": "string"
                  },
                  "isContainerRegistriesVulnerabilityAssessmentsEnabled": {
                    "type": "string"
                  },
                  "isAgentlessDiscoveryForKubernetesEnabled": {
                    "type": "string"
                  },
                  "isAgentlessVmScanningEnabled": {
                    "type": "string"
                  },
                  "isContainerSensorEnabled": {
                    "type": "string"
                  },
                  "isSecurityGatingEnabled": {
                    "type": "string"
                  },
                  "isContainerIntegrityContributionEnabled": {
                    "type": "string"
                  }
                },
                "variables": {
                  "standardProperties": {
                    "pricingTier": "Standard",
                    "extensions": [
                      {
                        "name": "ContainerRegistriesVulnerabilityAssessments",
                        "isEnabled": "[parameters('isContainerRegistriesVulnerabilityAssessmentsEnabled')]"
                      },
                      {
                        "name": "AgentlessDiscoveryForKubernetes",
                        "isEnabled": "[parameters('isAgentlessDiscoveryForKubernetesEnabled')]"
                      },
                      {
                        "name": "AgentlessVmScanning",
                        "isEnabled": "[parameters('isAgentlessVmScanningEnabled')]"
                      },
                      {
                        "name": "ContainerSensor",
                        "isEnabled": "[parameters('isContainerSensorEnabled')]",
                        "additionalExtensionProperties": {
                          "SecurityGatingEnabled": "[parameters('isSecurityGatingEnabled')]"
                        }
                      },
                      {
                        "name": "ContainerIntegrityContribution",
                        "isEnabled": "[parameters('isContainerIntegrityContributionEnabled')]"
                      }
                    ]
                  },
                  "freeProperties": {
                    "pricingTier": "Free"
                  }
                },
                "resources": [
                  {
                    "type": "Microsoft.Security/pricings",
                    "apiVersion": "2025-10-01-preview",
                    "name": "Containers",
                    "properties": "[if(equals(parameters('pricingTier'), 'Free'), variables('freeProperties'), variables('standardProperties'))]"
                  }
                ],
                "outputs": {}
              }
            }
          }
        }
      }
    }
  }
}
