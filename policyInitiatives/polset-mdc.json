        "additionalMetadataId": "/providers/Microsoft.PolicyInsights/policyMetadata/ISO27001-2013_A.16.1.2"
      },
      {
        "name": "ISO27001-2013_A.16.1.4",
        "additionalMetadataId": "/providers/Microsoft.PolicyInsights/policyMetadata/ISO27001-2013_A.16.1.4"
      },
      {
        "name": "ISO27001-2013_A.16.1.7",
        "additionalMetadataId": "/providers/Microsoft.PolicyInsights/policyMetadata/ISO27001-2013_A.16.1.7"
      },
      {
        "name": "ISO27001-2013_A.18.2.2",
        "additionalMetadataId": "/providers/Microsoft.PolicyInsights/policyMetadata/ISO27001-2013_A.18.2.2"
      },
      {
        "name": "ISO27001-2013_A.18.2.3",
        "additionalMetadataId": "/providers/Microsoft.PolicyInsights/policyMetadata/ISO27001-2013_A.18.2.3"
      }
    ],
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "MDC-001",
        "policyDefinitionId": "{policyLocationResourceId}/providers/Microsoft.Authorization/policyDefinitions/pol-deploy-defender-cspm",
        "parameters": {
          "effect": {
            "value": "[parameters('MDC-001_effect')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "isSensitiveDataDiscoveryEnabled": {
            "value": "[parameters('MDC-001_isSensitiveDataDiscoveryEnabled')]"
          },
          "isContainerRegistriesVulnerabilityAssessmentsEnabled": {
            "value": "[parameters('MDC-001_isContainerRegistriesVulnerabilityAssessmentsEnabled')]"
          },
          "isAgentlessDiscoveryForKubernetesEnabled": {
            "value": "[parameters('MDC-001_isAgentlessDiscoveryForKubernetesEnabled')]"
          },
          "isAgentlessVmScanningEnabled": {
            "value": "[parameters('MDC-001_isAgentlessVmScanningEnabled')]"
          },
          "isEntraPermissionsManagementEnabled": {
            "value": "[parameters('MDC-001_isEntraPermissionsManagementEnabled')]"
          },
          "isApiPostureEnabled": {
            "value": "[parameters('MDC-001_isApiPostureEnabled')]"
          },
          "isAgentlessServerlessPostureEnabled": {
            "value": "[parameters('MDC-001_isAgentlessServerlessPostureEnabled')]"
          }
        },
        "groupNames": [
          "ISO27001-2013_A.18.2.2",
