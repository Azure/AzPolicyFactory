{
  "name": "pol-deploy-defender-api",
  "properties": {
    "displayName": "Configure Microsoft Defender for APIs Plan",
    "mode": "All",
    "description": "Configure Microsoft Defender for APIs plan. Set the pricing tier to Free to disable the plan.",
    "metadata": {
      "version": "1.1.0",
      "category": "Defender for Cloud",
      "preview": false,
      "deprecated": false
    },
    "parameters": {
      "effect": {
        "type": "string",
        "defaultValue": "Disabled",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable the execution of the policy"
        },
        "allowedValues": [
          "DeployIfNotExists",
          "Disabled"
        ]
      },
      "evaluationDelay": {
        "type": "string",
        "metadata": {
          "displayName": "Evaluation Delay",
          "description": "Specifies when the existence of the related resources should be evaluated. The delay is only used for evaluations that are a result of a create or update resource request. Allowed values are AfterProvisioning, AfterProvisioningSuccess, AfterProvisioningFailure, or an ISO 8601 duration between 0 and 360 minutes."
        },
        "defaultValue": "AfterProvisioning"
      },
      "pricingTier": {
        "type": "string",
        "metadata": {
          "displayName": "Pricing Tier",
          "description": "Pricing tier of the Defender for APIs plan. Standard enables the plan, Free disables it. Sub plan parameter is ignored when set to Free."
        },
        "allowedValues": [
          "Standard",
          "Free"
        ],
        "defaultValue": "Standard"
      },
      "subPlan": {
        "type": "string",
        "metadata": {
          "displayName": "Defender for API plans",
          "description": "Select a Defender for API plan"
        },
        "allowedValues": [
          "P1",
          "P2",
          "P3",
          "P4",
          "P5"
        ],
        "defaultValue": "P1"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Resources/subscriptions"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]",
        "details": {
          "type": "Microsoft.Security/pricings",
          "evaluationDelay": "[parameters('evaluationDelay')]",
          "name": "Api",
          "deploymentScope": "subscription",
          "existenceScope": "subscription",
          "roleDefinitionIds": [
            "/providers/Microsoft.Authorization/roleDefinitions/fb1c8493-542b-48eb-b624-b4c8fea62acd"
          ],
          "existenceCondition": {
            "field": "Microsoft.Security/pricings/pricingTier",
            "equals": "[parameters('pricingTier')]"
          },
          "deployment": {
            "location": "australiaeast",
            "properties": {
              "mode": "incremental",
              "parameters": {
                "pricingTier": {
                  "value": "[parameters('pricingTier')]"
                },
                "subPlan": {
                  "value": "[parameters('subPlan')]"
                }
              },
              "template": {
                "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
                "contentVersion": "1.0.0.0",
                "parameters": {
                  "pricingTier": {
                    "type": "string"
                  },
                  "subPlan": {
                    "type": "string"
                  }
                },
                "variables": {
                  "standardProperties": {
                    "pricingTier": "Standard",
                    "subPlan": "[parameters('subPlan')]"
                  },
                  "freeProperties": {
                    "pricingTier": "Free"
                  }
                },
                "resources": [
                  {
                    "type": "Microsoft.Security/pricings",
                    "apiVersion": "2025-10-01-preview",
                    "name": "Api",
                    "properties": "[if(equals(parameters('pricingTier'), 'Free'), variables('freeProperties'), variables('standardProperties'))]"
                  }
                ],
                "outputs": {}
              }
            }
          }
        }
      }
    }
  }
}
